QQ_EMAIL_USER=
QQ_EMAIL_PASS=
QQ_SMTP_HOST=
QQ_SMTP_PORT=587
JWT_SECRET=
JWT_EXPIRES_HOURS=24

# 首次创建 db/db.sqlite3 时使用。用户名未填写时默认为 admin；密码不会提交到 Git。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# 博客和游戏共用的 GitHub Personal Access Token，切勿提交实际值。
GITHUB_PAT=

# 博客内容仓库：首次部署时 clone 到 blog 目录。
BLOG_REPO=
BLOG_GIT_BRANCH=main
# true 时，每次博客写入前执行 git pull。所有后台博客写入都会自动 commit 并推送；“获取 GitHub 更新”仅拉取远端内容。
BLOG_GIT_AUTO_SYNC=false

# 游戏内容仓库：首次部署时 clone 到 game 目录。上传或删除会自动 commit 并推送 ZIP、解压目录和 games.json；“获取 GitHub 代码”仅拉取远端更新。
GAME_REPO=
GAME_GIT_BRANCH=main
