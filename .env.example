QQ_EMAIL_USER=
QQ_EMAIL_PASS=
QQ_SMTP_HOST=
QQ_SMTP_PORT=587
JWT_SECRET=
JWT_EXPIRES_HOURS=24

# 首次创建 db/db.sqlite3 时使用。用户名未填写时默认为 admin；密码不会提交到 Git。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# 博客内容仓库：首次部署时 clone 到 blog 目录。Token 使用有该仓库 Contents 读写权限的 GitHub Personal Access Token，切勿提交实际值。
BLOG_GIT_REPO=
BLOG_GIT_BRANCH=main
BLOG_GIT_USERNAME=
BLOG_GIT_TOKEN=
# true 时，每次博客写入前执行 git pull；推送仍由后台的“GitHub 同步”按钮触发。
BLOG_GIT_AUTO_SYNC=false

# 游戏内容仓库：首次部署时 clone 到 game 目录。上传的 ZIP、解压后的游戏目录和 games.json 都会同步。
GAME_GIT_REPO=
GAME_GIT_BRANCH=main
GAME_GIT_USERNAME=
GAME_GIT_TOKEN=
